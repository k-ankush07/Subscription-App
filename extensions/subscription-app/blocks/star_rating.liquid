{% comment %} 


{% schema %}
{
  "name": "subscription",
  "target": "section",
  "stylesheet": "subscription.css",
  "javascript": "subscription.js",
  "settings": []
}
{% endschema %}



{% if product.selling_plan_groups.size > 0 %}
<div class="subscription-widget" id="subscription-widget">
  <label class="purchase-option">
    <input type="radio" name="purchase_type" value="one_time" checked>
    <span>One-time Purchase</span>
  </label>

  <label class="purchase-option">
    <input type="radio" name="purchase_type" value="subscription">
    <span>Subscribe &amp; Save</span>
  </label>

  <div id="selling-plans-container" style="display:none; margin-top: 10px;">
    <select id="selling-plan-select" name="selling_plan">
  {% for group in product.selling_plan_groups %}
    <optgroup  label="{{ group.name }}">
      {% for plan in group.selling_plans %}
        <option  value="{{ plan.id | split: '/' | last }}">{{ plan.name }}</option>
      {% endfor %}
    </optgroup>
  {% endfor %}
</select>
  </div>

</div>

  <div class="subscription_Outer" id="subscription_Outer">
        <p class="Subscription_innerText" id="Subscription_innerText"></p>
        <p class="subscription_discount"></p>
        
  </div>
{% endif %} {% endcomment %}



{% schema %}
{
  "name": "subscription",
  "target": "section",
  "stylesheet": "subscription.css",
  "javascript": "subscription.js",
  "settings": []
}
{% endschema %}

{% if product.selling_plan_groups.size > 0 %}
<div
  class="subscription-widget"
  id="subscription-widget"
  data-product-id="{{ product.id }}"
>
  <label class="purchase-option">
    <input type="radio" name="purchase_type" value="one_time" checked>
    <span>One-time Purchase</span>
  </label>

  <label class="purchase-option">
    <input type="radio" name="purchase_type" value="subscription">
    <span>Subscribe &amp; Save</span>
  </label>

  <div id="selling-plans-container" style="display:none; margin-top: 10px;">
    <select id="selling-plan-select" name="selling_plan">
  {% for group in product.selling_plan_groups %}
    <optgroup label="{{ group.name }}">
      {% for plan in group.selling_plans %}
        <option value="{{ plan.id | split: '/' | last }}">{{ plan.name }}</option>
      {% endfor %}
    </optgroup>
  {% endfor %}
</select>
  </div>

</div>

  <div class="subscription_Outer" id="subscription_Outer">
        <p class="Subscription_innerText" id="Subscription_innerText"></p>
        <p class="subscription_discount"></p>

        <!-- naya: "Upcoming product changes" card — JS isko fill karega -->
        <div class="upc-card" id="upcoming-changes-card" style="display:none;">
          <button type="button" class="upc-card__header" data-upc-toggle="card">
            <span class="upc-card__title">Upcoming product changes</span>
            <svg class="upc-chevron" width="16" height="16" viewBox="0 0 16 16"><path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
          <div class="upc-card__body" id="upcoming-changes-body"></div>
        </div>
  </div>
{% endif %}
