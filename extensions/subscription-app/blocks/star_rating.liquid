{% comment %} 


{% schema %}
{
  "name": "subscription",
  "target": "section",
  "stylesheet": "subscription.css",
  "javascript": "subscription.js",
  "settings": []
}
{% endschema %}


{% if product.selling_plan_groups.size > 0 %}
<div class="subscription-widget" id="subscription-widget">
  <label class="purchase-option">
    <input type="radio" name="purchase_type" value="one_time" checked>
    <span>One-time Purchase</span>
  </label>

  <label class="purchase-option">
    <input type="radio" name="purchase_type" value="subscription">
    <span>Subscribe &amp; Save</span>
  </label>

  <div id="selling-plans-container" style="display:none; margin-top: 10px;">
    <select id="selling-plan-select" name="selling_plan">
  {% for group in product.selling_plan_groups %}
    <optgroup  label="{{ group.name }}">
      {% for plan in group.selling_plans %}
        <option  value="{{ plan.id | split: '/' | last }}">{{ plan.name }}</option>
      {% endfor %}
    </optgroup>
  {% endfor %}
</select>
  </div>

</div>

  <div class="subscription_Outer" id="subscription_Outer">
        <p class="Subscription_innerText" id="Subscription_innerText"></p>
        <p class="subscription_discount"></p>
        
  </div>
{% endif %} {% endcomment %}


{% comment %}
  Old version looped every product.selling_plan_groups and rendered a generic
  radio + <select>. Now the section just exposes a mount point; subscription.js
  auto-matches the current product/variant to its assigned plan (via
  /plans/getAllPlans) and then fetches that plan's widget (via
  /api/widgets/:widgetId) to render the ACTUAL widget design — colors,
  template (radio/highlight/checkbox), titles, discount labels — exactly as
  configured in the app, instead of a plain Shopify dropdown.
{% endcomment %}

<div
  id="subscription-widget-mount"
  data-product-id="{{ product.id }}"
  data-price="{{ product.selected_or_first_available_variant.price | divided_by: 100.0 }}"
  data-currency="{{ cart.currency.iso_code }}"
  data-design-mode="{{ request.design_mode }}"
  style="display:none;"
></div>

{% schema %}
{
  "name": "subscription",
  "target": "section",
  "stylesheet": "subscription.css",
  "javascript": "subscription.js",
  "settings": []
}
{% endschema %}
