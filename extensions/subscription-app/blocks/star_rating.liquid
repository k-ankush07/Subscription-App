<div
  id="subscription-widget-mount"
  data-product-id="{{ product.id }}"
  data-price="{{ product.selected_or_first_available_variant.price | divided_by: 100.0 }}"
  data-currency="{{ cart.currency.iso_code }}"
  data-design-mode="{{ request.design_mode }}"
  style="display:none;"
></div>

{% schema %}
{
  "name": "subscription",
  "target": "section",
  "stylesheet": "subscription.css",
  "javascript": "subscription.js",
  "settings": []
}
{% endschema %}